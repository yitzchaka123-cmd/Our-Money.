# ---------------------------------------------------------------------------
# Our Money — cash ledger for RiseUp
# Copy to .env.local for local dev; set the same names in Vercel for production.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Optional. Telegram echoes it back on every webhook call, which is how we know
# a request is really from Telegram. Leave it unset and it is derived from
# APP_SESSION_SECRET. If set: letters, digits, _ and - only.
TELEGRAM_WEBHOOK_SECRET=

# Optional: the shared family group chat id (negative number, e.g. -1001234567890).
# Summaries and withdrawal alerts are posted here. Leave blank to disable.
TELEGRAM_GROUP_CHAT_ID=

# Comma-separated Telegram numeric user ids allowed to use the bot.
# Seeds the household_members table on first contact. Get yours from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# --- Claude (AI intake) -----------------------------------------------------
ANTHROPIC_API_KEY=

# Effort for the intake parse. low is plenty for short expense messages;
# raise to medium if you see mis-parses on long/rambling voice notes.
INTAKE_EFFORT=low

# --- OpenAI (speech-to-text only) -------------------------------------------
# Used exclusively to transcribe Telegram voice notes. Claude handles all
# language understanding; this is here because Claude does not accept audio.
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe
# Optional ISO-639-1 hint. Leave blank to auto-detect (best if you mix
# Hebrew and English); set to "he" for maximum Hebrew accuracy.
STT_LANGUAGE=

# --- RiseUp (read-only) -----------------------------------------------------
# Create at https://input.riseup.co.il/developer/tokens with the budget:read
# scope. NOTE: tokens expire after 30 days — the bot will warn you in the group
# chat when a sync fails with 401 so you can mint a new one.
RISEUP_PAT=
RISEUP_API_BASE=https://input.riseup.co.il

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
# Service role key — server-side only, never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard ---------------------------------------------------------------
# Signs the dashboard login links the bot sends. openssl rand -hex 32
APP_SESSION_SECRET=
# Optional on Vercel: defaults to the project's production domain. Set it only
# for a custom domain, or when running somewhere else. No trailing slash.
APP_BASE_URL=

# --- Cron -------------------------------------------------------------------
# Protects the cron endpoints (RiseUp sync, evening nudge). openssl rand -hex 32
CRON_SECRET=

# The evening "anything in cash today?" message and the due-plan buttons.
# On by default; set to off to silence it without touching the schedule.
EVENING_NUDGE=on
